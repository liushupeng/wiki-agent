{
  "name": "wiki-agent",
  "version": "1.0.0",
  "description": "A local Markdown wiki agent built with Agentic RAG",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "ask": "tsx src/main.ts",
    "index:notes": "tsx scripts/rag/indexKnowledgeBase.ts",
    "eval:rag": "tsx scripts/rag/evaluateRag.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "test": "npm run clean && npm run build && node --test \"dist/src/tests/**/*.test.js\"",
    "test:coverage": "npm run clean && npm run build && node --test --experimental-test-coverage \"dist/src/tests/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushupeng/wiki-agent.git"
  },
  "keywords": [],
  "author": "LiuShuPeng",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/liushupeng/wiki-agent/issues"
  },
  "homepage": "https://github.com/liushupeng/wiki-agent#readme"
}
