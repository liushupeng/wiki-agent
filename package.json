{
  "name": "wiki-agent",
  "version": "1.0.0",
  "description": "A local Markdown wiki agent built with Agentic RAG",
  "type": "module",
  "scripts": {
    "ask": "tsx src/main.ts",
    "check:config": "tsx scripts/checkConfig.ts",
    "check:llm": "tsx scripts/checkLlm.ts",
    "check:mcp": "tsx scripts/mcp/checkMcpServers.ts",
    "check:rag-models": "tsx scripts/rag/checkLocalModels.ts",
    "trace:import": "tsx scripts/observability/importTrace.ts",
    "index:knowledge": "tsx scripts/rag/indexKnowledgeBase.ts",
    "eval:recall": "tsx scripts/evaluation/evaluateRecall.ts",
    "eval:agent": "tsx scripts/evaluation/evaluateAgent.ts",
    "eval:verify": "tsx scripts/evaluation/verifyTrajectory.ts",
    "eval:review": "tsx scripts/evaluation/summarizeAgentReview.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "test": "npm run clean && npm run build && node --test --test-concurrency=1 \"dist/src/tests/**/*.test.js\"",
    "test:coverage": "npm run clean && npm run build && node --test --test-concurrency=1 --experimental-test-coverage \"dist/src/tests/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushupeng/wiki-agent.git"
  },
  "keywords": [],
  "author": "LiuShuPeng",
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.37.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "dotenv": "^17.4.2",
    "jsonc-parser": "^3.3.1",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/liushupeng/wiki-agent/issues"
  },
  "homepage": "https://github.com/liushupeng/wiki-agent#readme"
}
