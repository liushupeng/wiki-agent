{
  "$schema": "./knowledge.catalog.schema.json",
  // 文档治理目录。未列出的来源默认视为 active / normal / quality=0.5，
  // 因而可以渐进式接入，不要求一次性为全部知识打标。
  "version": 1,
  "records": [
    // 示例：
    // {
    //   "sourceId": "raw/example-v1.md",
    //   "versionId": "example@1",
    //   "status": "superseded",
    //   "authority": "low",
    //   "quality": 0.4,
    //   "consistencyStatus": "clear",
    //   "supersededBy": "example@2"
    // },
    // {
    //   "sourceId": "wiki/example-v2.md",
    //   "versionId": "example@2",
    //   "status": "active",
    //   "authority": "high",
    //   "quality": 0.9,
    //   "consistencyStatus": "conditional",
    //   "validFrom": "2026-08-20"
    // }
  ]
}
