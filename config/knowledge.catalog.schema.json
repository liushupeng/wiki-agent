{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wiki-agent Knowledge Catalog",
  "type": "object",
  "required": ["version", "records"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["sourceId", "versionId", "status", "authority", "quality", "consistencyStatus"],
      "additionalProperties": false,
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "superseded", "archived", "quarantined", "deleted"] },
        "authority": { "enum": ["high", "normal", "low"] },
        "quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "consistencyStatus": { "enum": ["clear", "conditional", "conflicted", "unknown"] },
        "validFrom": { "type": "string", "format": "date" },
        "validTo": { "type": "string", "format": "date" },
        "supersededBy": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["claimId", "entity", "metric", "value"],
      "additionalProperties": false,
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "entity": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number"] },
        "asOf": { "type": "string", "format": "date" },
        "scenario": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "chapter": { "type": "string", "minLength": 1 },
        "assumption": { "type": "string", "minLength": 1 }
      }
    }
  }
}
