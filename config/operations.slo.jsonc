{
  // 初始本地 CPU SLO。获得至少 30 次生产式运行样本后再收紧阈值。
  "minimumSampleRuns": 30,
  "minimumKnowledgeRuns": 20,
  "completionRateMin": 0.95,
  "p95LatencyMsMax": 600000,
  "toolFailureRateMax": 0.05,
  "ragRetrieverCacheHitRateMin": 0.60,
  "ragBudgetExhaustionRateMax": 0.10,
  "averageTotalTokensMax": 200000,
  // 以下是无金标的风险代理指标，不等价于答案准确率。
  "insufficientEvidenceRateMax": 0.20,
  "partialEvidenceRateMax": 0.30,
  "fallbackRateMax": 0.30,
  "emptyRetrievalRateMax": 0.20,
  "retrievalP95LatencyMsMax": 300000
}
