{
  "$schema": "./knowledge.sources.schema.json",
  "sources": [
    {
      // 知识源的唯一名称，也会作为检索结果中 source 路径的前缀。
      "name": "wiki",

      // 知识源根目录。相对路径以启动 wiki-agent 时的工作目录为基准。
      "root": "wiki",

      // 内容类型：wiki=维护后的知识，raw=原始资料，code=源码，data=结构化数据。
      "kind": "wiki",

      // 是否启用该知识源；设为 false 时不会加载或索引。
      "enabled": true,

      // 是否为该知识源建立索引；设为 false 时从索引任务中排除。
      "index": true,

      // 检索优先级，数值越大排序越靠前；wiki 默认 100，raw 默认 50，其他默认 10。
      "priority": 100,

      // 相对于 root 的 glob 忽略规则。
      "ignore": []
    },
    {
      "name": "raw",
      "root": "notes",
      "kind": "raw",
      "enabled": true,
      "index": true,
      "priority": 50,
      "ignore": [
        "**/.git/**",
        "**/node_modules/**",
        "**/__pycache__/**",
        "**/dist/**",
        "**/build/**",
        "**/.next/**",
        "**/.cache/**",
        "**/finalData/**",
      ],
    },
  ],
}
