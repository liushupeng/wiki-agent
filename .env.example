# =============================================================================
# LLM
# Controls the OpenAI-compatible model endpoint used by the agent.
# =============================================================================

# OpenAI-compatible API base URL. 可配置为 DeepSeek、HY3 或其他兼容服务。
BASE_URL=https://api.deepseek.com

# LLM API key 必须在本地 .env、操作系统环境变量或 CI secret 中设置，不能提交到代码库。
# API_KEY=your_real_api_key

# Agent 调用的模型名称。
MODEL_NAME=deepseek-v4-flash

# =============================================================================
# Agent runtime
# Controls sandboxing, approval behavior, tracing, tool limits, and memory budget.
# =============================================================================

# 文件、搜索和通用 shell 工具的沙箱根目录；这些工具不能访问该目录之外的路径。
AGENT_SANDBOX_ROOT=C:\AgentSandbox

# Coding 工具的工作区根目录；git_status、git_diff、apply_patch、run_tests 在这里执行。
AGENT_WORKSPACE_ROOT=.

# write_file 可写目录的受信任 JSONC 配置。默认仅有 sandbox；此项目示例额外声明了 wiki。
# 配置中的 root 必须相对于 AGENT_WORKSPACE_ROOT，且不得越出工作区。
WRITE_SCOPES_CONFIG_PATH=config/write.scopes.jsonc

# 单次 Agent run 最多允许多少轮 model/tool 循环，防止无限调用工具。
MAX_LOOP_STEPS=50

# 单次 Agent run 最多实际执行多少次 RAG 工具；达到预算后隐藏 RAG schema，要求基于已有证据回答或说明缺口。
MAX_RAG_CALLS=8

# telemetry 后端候选项：
# - file（默认）：写入 TRACE_DIR 下的 JSONL；Agent 结束后会尝试导入本地 Jaeger。
# - otlp：不写 JSONL，直接导出到 OTEL_EXPORTER_OTLP_TRACES_ENDPOINT。
TELEMETRY_BACKEND=file

# TELEMETRY_BACKEND=file 时每次 Agent run 的 JSONL trace 输出目录。
TRACE_DIR=var/traces

# 是否将脱敏后的完整 LLM 请求写为本地 artifact。默认关闭；artifact 不会写入 Jaeger attributes。
TRACE_CAPTURE_PROMPTS=false

# TRACE_CAPTURE_PROMPTS=true 时的 artifact 输出目录。
TRACE_ARTIFACT_DIR=var/traces/artifacts

# 本地运行 SLI 的初始 SLO 阈值；ops:summary 会同时给出样本量和各项达标状态。
OPERATIONS_SLO_PATH=config/operations.slo.jsonc

# TELEMETRY_BACKEND=otlp 时必填。OTEL_EXPORTER_OTLP_PROTOCOL 可选 http 或 grpc，默认 http。
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http

# 工具审批模式：prompt=风险工具询问用户，auto=自动执行通过安全检查的工具，deny=拒绝需要审批的工具。
APPROVAL_MODE=prompt

# 单个工具结果写回模型前的最大字符数，避免大输出污染上下文。
TOOL_OUTPUT_MAX_CHARS=12000

# 所有工具结果写回模型上下文前的统一总字符预算；作为各工具自身限制之外的最终防线。
CONTEXT_TOOL_RESULT_MAX_CHARS=6000

# read_file 默认最多读取的字节数；用户传入 maxBytes 时也不会超过这个上限。
READ_FILE_MAX_BYTES=200000

# execute_command 的默认超时时间，单位毫秒。
SHELL_TIMEOUT_MS=5000

# shell/coding 命令 stdout+stderr 的进程级缓冲上限，单位字节。
SHELL_MAX_BUFFER_BYTES=1048576

# run_tests 工具允许的最大超时时间，单位毫秒；工具参数里的 timeoutMs 会被限制在该值以内。
RUN_TESTS_MAX_TIMEOUT_MS=120000

# memory 触发压缩前允许的最大消息数。
MEMORY_MAX_MESSAGES=40

# memory 压缩时保留最近多少条原始消息，其余旧消息进入中期摘要。
MEMORY_KEEP_RECENT_MESSAGES=18

# memory 触发压缩前允许的估算最大字符数。
MEMORY_MAX_CHARS=60000

# 会话与显式长期记忆的本地目录；SQLite 状态和按日 Markdown 日志都保存在这里。
MEMORY_DIR=var/memory

# 未更新会话保留天数；0 表示每次启动时清理历史会话。
MEMORY_SESSION_RETENTION_DAYS=30

# 按日会话日志保留天数；0 表示每次启动时清理历史日志。
MEMORY_JOURNAL_RETENTION_DAYS=90

# =============================================================================
# MCP
# Controls optional Model Context Protocol servers exposed as Agent tools.
# =============================================================================

# MCP server 配置文件路径；字段说明、校验和自动补全见该文件关联的 JSON Schema。
MCP_CONFIG_PATH=config/mcp.servers.jsonc

# =============================================================================
# RAG
# Controls note indexing, chunking, embedding, and vector-store selection.
# =============================================================================

# 知识源 JSONC 配置文件路径。Schema 会提示数据源类型、优先级和 ignore 等字段。
KNOWLEDGE_SOURCES_CONFIG_PATH=config/knowledge.sources.jsonc

# 文档版本、状态、权威性、质量与一致性治理目录；变更后必须重建索引。
KNOWLEDGE_CATALOG_PATH=config/knowledge.catalog.jsonc

# RAG index profile JSONC 配置。activeProfile 决定 ask/eval 使用的索引。
RAG_INDEXES_CONFIG_PATH=config/rag.indexes.jsonc

# 产品检索模式：fast=BM25，balanced=较小 Hybrid+Reranker，deep=评测最佳完整管线。
# 与 RAG_RETRIEVAL_PROFILE 互斥；日常交互建议 balanced，严格评测显式使用 deep profile。
RAG_RETRIEVAL_MODE=balanced
RAG_INDEX_VARIANT=raw-wiki

# CPU 密集检索的进程内最大并发数；CPU 模式建议保持 1，避免多个 Reranker 任务互相争抢。
RAG_RETRIEVAL_MAX_CONCURRENCY=1

# 高级覆盖：直接指定 config/rag.retrieval.jsonc 中的 profile，设置后不要再设置 RAG_RETRIEVAL_MODE。
# RAG_RETRIEVAL_PROFILE=hybrid-bge-m3-metadata-source-aggregate-v1

# 使用 openai-compatible embedding profile 时，profile 通过这些变量取得服务端地址和密钥。
# RAG_EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1
# RAG_EMBEDDING_API_KEY=your_embedding_api_key
