# =============================================================================
# LLM
# Controls the OpenAI-compatible model endpoint used by the agent.
# =============================================================================

# OpenAI-compatible API base URL. 当前默认指向 DeepSeek。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM API key. 本地 .env 中填写真实 key，不能提交到代码库。
DEEPSEEK_API_KEY=your_deepseek_api_key

# Agent 调用的模型名称。
DEEPSEEK_MODEL_NAME=deepseek-v4-pro

# =============================================================================
# Agent runtime
# Controls sandboxing, approval behavior, tracing, tool limits, and memory budget.
# =============================================================================

# 文件、搜索和通用 shell 工具的沙箱根目录；这些工具不能访问该目录之外的路径。
AGENT_SANDBOX_ROOT=C:\AgentSandbox

# Coding 工具的工作区根目录；git_status、git_diff、apply_patch、run_tests 在这里执行。
AGENT_WORKSPACE_ROOT=.

# 单次 Agent run 最多允许多少轮 model/tool 循环，防止无限调用工具。
MAX_LOOP_STEPS=20

# 每次 Agent run 的 JSONL trace 输出目录。
TRACE_DIR=var/traces

# trace 最低写入级别：debug、info、warn、error。debug 会记录权限决策、RAG 搜索、memory 压缩等细节。
TRACE_LEVEL=info

# 工具审批模式：prompt=风险工具询问用户，auto=自动执行通过安全检查的工具，deny=拒绝需要审批的工具。
APPROVAL_MODE=prompt

# 单个工具结果写回模型前的最大字符数，避免大输出污染上下文。
TOOL_OUTPUT_MAX_CHARS=12000

# read_file 默认最多读取的字节数；用户传入 maxBytes 时也不会超过这个上限。
READ_FILE_MAX_BYTES=200000

# execute_command 的默认超时时间，单位毫秒。
SHELL_TIMEOUT_MS=5000

# shell/coding 命令 stdout+stderr 的进程级缓冲上限，单位字节。
SHELL_MAX_BUFFER_BYTES=1048576

# run_tests 工具允许的最大超时时间，单位毫秒；工具参数里的 timeoutMs 会被限制在该值以内。
RUN_TESTS_MAX_TIMEOUT_MS=120000

# memory 触发压缩前允许的最大消息数。
MEMORY_MAX_MESSAGES=40

# memory 压缩时保留最近多少条原始消息，其余旧消息进入中期摘要。
MEMORY_KEEP_RECENT_MESSAGES=18

# memory 触发压缩前允许的估算最大字符数。
MEMORY_MAX_CHARS=60000

# =============================================================================
# MCP
# Controls optional Model Context Protocol servers exposed as Agent tools.
# =============================================================================

# MCP server 配置文件路径；默认读取随代码提交的 config/mcp.servers.json。
MCP_CONFIG_PATH=config/mcp.servers.json

# MCP 配置文件是 JSON 数组。每个 server 使用 stdio 启动，server 暴露的 tools 会被包装成 Agent tools。
# 配置文件字段说明：
# - name: MCP server 的本地名称，用于日志和 metadata。
# - command/args/cwd/env: 启动 MCP server 的 stdio 进程参数。
# - toolNamePrefix: 包装后的工具名前缀，避免不同 server 的 tool 重名。
# - defaultPermission: MCP tool 的默认能力类别，通常填 mcp。
# - defaultRiskLevel: MCP tool 缺少 readOnly/destructive 等 annotation 时采用的默认风险等级。
# - enabled: false 时跳过该 server。

# =============================================================================
# RAG
# Controls note indexing, chunking, embedding, and vector-store selection.
# =============================================================================

# 默认单根知识源目录；未配置 KNOWLEDGE_SOURCE_ROOTS 时，index:notes 和 RAG 工具从这里读取。
NOTES_ROOT=notes

# 多知识源配置，格式为 prefix=path;prefix=path。prefix 会写入检索结果 source。
# 推荐把 agent-maintained wiki 和 raw sources 分开索引；这里保留 notes 作为 raw 示例目录。
KNOWLEDGE_SOURCE_ROOTS=wiki=wiki;raw=notes

# 默认知识索引文件路径；RAG 工具和 eval:rag 默认从这里读取索引。
KNOWLEDGE_INDEX_PATH=var/knowledge/index.json

# 向量存储后端。当前支持 json，后续可扩展 pgvector、lancedb、qdrant 等。
RAG_STORE=json

# embedding 实现。当前支持 tf，本地词频向量，不依赖外部 embedding 服务。
RAG_EMBEDDER=tf

# chunker 选择策略。当前支持 auto，按文件扩展名选择 Markdown/text chunker。
RAG_CHUNKER=auto

# 单个 chunk 的目标字符数；越大上下文越完整，越小检索粒度越细。
RAG_CHUNK_SIZE=900

# 相邻 chunk 重叠字符数，用来减少切分边界造成的信息丢失。
RAG_CHUNK_OVERLAP=120
